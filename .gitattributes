# 统一换行：文本文件一律 LF，批处理保持 CRLF（cmd 对 LF 的 bat 有兼容问题）
* text=auto eol=lf

*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.sh      text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制，禁止换行转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.mp4     binary
*.mp3     binary
*.zip     binary
